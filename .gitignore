logs/
results/
security/state/
backups/
earth_weather/data/
.claude/

# Public / Private Security Boundary Audit (Phase 29): these hold this
# deployment's real hostnames/IPs/usernames. Only the .example template
# next to each is public; copy it, fill in real values, and it stays
# local-only. If any of these is missing entirely, the code that reads
# it fails closed (workers/800.json missing -> that worker errors;
# security/egress_allowlist.conf missing -> egress_check() denies
# everything and trips Emergency Shutdown) -- never silently proceeds
# with no config.
workers/750.json
workers/800.json
security/egress_allowlist.conf
security/ssh_management_allowlist.conf
security/segments.conf

# security/knowledge/*.json (Phase 79): each is a real PROMOTED
# Incident Learning Engine entry (security/incident_learning/
# knowledge_manager.sh's knowledge_promote()) -- carries this
# deployment's own real cve_list/ioc_list/source_url/raw_text from an
# actual reviewed incident, same class of per-deployment real data as
# every path above. Only security/knowledge/EXAMPLE-*.json.example
# (fake data, matching this repo's own RFC 5737/CVE-2026-XXXXX test-
# fixture convention) is public. The directory itself is not
# gitignored -- knowledge_manager.sh's own `mkdir -p` recreates it on
# first run, same as every security/state/ subpath.
security/knowledge/*.json
