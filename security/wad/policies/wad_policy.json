{
  "policy_id": "wad-default",
  "version": 1,
  "actions": {
    "monitor_increase": {"class": "observe", "requires_approval": false},
    "warn_operator": {"class": "notify", "requires_approval": false},
    "restrict_egress": {"class": "disruptive", "requires_approval": true},
    "isolate_agent": {"class": "disruptive", "requires_approval": true},
    "recover": {"class": "disruptive", "requires_approval": true}
  },
  "levels": {
    "L0": [],
    "L1": ["monitor_increase"],
    "L2": ["monitor_increase", "warn_operator"],
    "L3": ["monitor_increase", "warn_operator", "restrict_egress"],
    "L4": ["monitor_increase", "warn_operator", "restrict_egress", "isolate_agent"],
    "UNDETERMINED": ["monitor_increase", "warn_operator"]
  },
  "limits": {
    "max_disruptive_per_hour": 3,
    "replay_window_s": 86400,
    "clock_skew_s": 300,
    "max_events_per_run": 5000
  }
}
