<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Per-user launchd agent that serves the WAIO Dashboard on port
         8000 via dashboard/serve_dashboard.py -- a hardcoded exact-path
         allowlist (index.html/earth_weather.html plus seven specific
         logs/*.json files), NOT a directory-serving command. Replaces
         this file's own prior `python3 -m http.server --directory
         dashboard` ProgramArguments, which could not reach `logs/`
         (a sibling of `dashboard/`) at all -- every data panel's own
         `fetch("../logs/*.json")` 404'd under that configuration,
         silently falling back to index.html's embedded sample data.
         serve_dashboard.py's own header documents the allowlist and
         why `snd-status-latest.json` is deliberately excluded from it
         (SND_HOME's own API gates that exact data, a LAN device list,
         behind a Bearer token for a documented reason). This agent
         only serves static files that dashboard/refresh_dashboard_cron.sh
         (see its own separate LaunchAgent,
         com.waio.dashboard-refresh.plist.example) already produces --
         it does not run, wrap, or depend on any WAIO core/pipeline
         script itself.

         Template only. Copy to
         ~/Library/LaunchAgents/com.waio.dashboard-server.plist,
         replace /ABSOLUTE/PATH/TO/WAIO below with this deployment's
         real repo path, then:

           launchctl load ~/Library/LaunchAgents/com.waio.dashboard-server.plist

         The real, installed copy is deployment-specific and is not
         committed -- it lives only in ~/Library/LaunchAgents on this
         machine, same as com.waio.dashboard-refresh.plist /
         com.waio.segment-monitor.plist / com.takomachi.agent.plist. -->

    <key>Label</key>
    <string>com.waio.dashboard-server</string>

    <!-- No UserName/GroupName key -- a per-user LaunchAgent, not a
         /Library/LaunchDaemons system daemon; runs as whichever user
         is logged in, never root. Port 8000 needs no elevated
         privilege, so there is no reason to run this as root. -->

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/ABSOLUTE/PATH/TO/WAIO/dashboard/serve_dashboard.py</string>
    </array>

    <!-- serve_dashboard.py binds 127.0.0.1 by default. LAN access
         (iPad/iPhone) is opt-in and fails closed: a non-loopback bind
         refuses to start unless HTTP Basic auth AND a private client
         allowlist are both configured (see serve_dashboard.py's
         "Access policy" header). To enable it:

           1. python3 /ABSOLUTE/PATH/TO/WAIO/dashboard/set_dashboard_auth.py \
                --user ipad --out ~/.config/waio/dashboard-auth
              (prompts for a password; stores only a PBKDF2 hash, 0600,
              outside the repo)
           2. uncomment the block below, with this LAN's own subnet and
              the absolute path to the file written in step 1
              (launchd does not expand "~").

         Basic auth travels in cleartext on the LAN: use a password
         unique to this dashboard.

    <key>EnvironmentVariables</key>
    <dict>
        <key>WAIO_DASHBOARD_BIND</key>
        <string>0.0.0.0</string>
        <key>WAIO_DASHBOARD_AUTH_FILE</key>
        <string>/Users/USERNAME/.config/waio/dashboard-auth</string>
        <key>WAIO_DASHBOARD_ALLOWED_CLIENTS</key>
        <string>192.168.1.0/24</string>
    </dict>
    -->

    <!-- Long-running service, not a periodic poll: start it as soon as
         this user session comes up, and bring it straight back if it
         ever exits for any reason (killed, crashed, port stolen then
         freed again, etc). This is the opposite of
         com.waio.dashboard-refresh.plist's StartInterval-only,
         RunAtLoad/KeepAlive-off setup, which is correct for a job
         that is expected to run to completion and exit each time. -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Floor between respawns so a persistent failure (e.g. port 8000
         already held by another process) can't spin-loop; this is
         launchd's own default but is spelled out here deliberately. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/WAIO/logs/dashboard-server-launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/WAIO/logs/dashboard-server-launchd.log</string>
</dict>
</plist>
